{
  "name": "lua-dap-debugger",
  "displayName": "Lua DAP Debugger",
  "description": "通用 Lua 调试器 — 基于 Debug Adapter Protocol",
  "version": "0.1.0",
  "publisher": "lua-dap",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Debuggers"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebug"
  ],
  "contributes": {
    "configuration": {
      "title": "Lua DAP",
      "properties": {
        "luadap.runnerPath": {
          "type": "string",
          "default": "",
          "description": "Override path to lua-runner (otherwise the bundled Windows x64 binary is used)"
        },
        "luadap.defaultPort": {
          "type": "number",
          "default": 8172,
          "description": "Default DAP TCP port for Attach"
        }
      }
    },
    "debuggers": [
      {
        "type": "lua-dap",
        "label": "Lua DAP",
        "languages": ["lua"],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Lua file to debug"
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Arguments passed to the Lua script"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory"
              },
              "host": {
                "type": "string",
                "description": "DAP listen address (default 127.0.0.1)"
              },
              "port": {
                "type": "number",
                "description": "DAP listen port (default: pick a free port)"
              },
              "runnerPath": {
                "type": "string",
                "description": "Override path to lua-runner for this session"
              }
            }
          },
          "attach": {
            "properties": {
              "host": {
                "type": "string",
                "description": "DAP server address",
                "default": "127.0.0.1"
              },
              "port": {
                "type": "number",
                "description": "DAP server port",
                "default": 8172
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Lua DAP: Launch",
            "description": "Launch a Lua file via lua-runner",
            "body": {
              "type": "lua-dap",
              "request": "launch",
              "name": "Lua DAP: Launch current file",
              "program": "${file}",
              "args": [],
              "cwd": "${workspaceFolder}"
            }
          },
          {
            "label": "Lua DAP: Attach",
            "description": "Attach to a process already listening for DAP",
            "body": {
              "type": "lua-dap",
              "request": "attach",
              "name": "Lua DAP: Attach",
              "host": "127.0.0.1",
              "port": 8172
            }
          }
        ],
        "initialConfigurations": [
          {
            "type": "lua-dap",
            "request": "launch",
            "name": "Lua DAP: Launch current file",
            "program": "${file}",
            "args": [],
            "cwd": "${workspaceFolder}"
          },
          {
            "type": "lua-dap",
            "request": "attach",
            "name": "Lua DAP: Attach",
            "host": "127.0.0.1",
            "port": 8172
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
